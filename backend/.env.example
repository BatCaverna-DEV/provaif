# Copie este arquivo para .env e ajuste os valores

# Servidor
PORTA=3000

# Banco de dados (MariaDB)
DB_HOST=localhost
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=
DB_NOME=provaif

# true = mostra o SQL gerado no console
DB_LOG=false
# true = altera as tabelas existentes para refletir mudanças nos models
DB_ALTER=false

# Origens autorizadas a acessar a API (CORS), separadas por vírgula.
# Deixe comentado em desenvolvimento para liberar http://localhost em qualquer porta.
# CORS_ORIGEM=https://provaif.exemplo,https://www.provaif.exemplo

# Autenticação (JWT)
# Obrigatório em produção. Gere um valor longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=
# Tempo de validade do token de login (ex.: 30m, 8h, 7d)
JWT_EXPIRA_EM=8h
